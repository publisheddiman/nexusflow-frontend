"use client";

import {
  useQuery,
  useQueryClient,
} from "@tanstack/react-query";
import axios from "axios";
import {
  CheckCircle2,
  CircleDashed,
  Eye,
  GitBranch,
  LockKeyhole,
  Pencil,
  Trash2,
  TriangleAlert,
  UserRound,
  X,
} from "lucide-react";
import {
  useMemo,
  useState,
} from "react";
import { TaskFormModal } from "@/components/tasks/task-form-modal";
import { Button } from "@/components/ui/button";
import type { ProjectRecord } from "@/lib/api/projects";
import {
  addTaskDependency,
  changeTaskStatus,
  deleteTask,
  getTaskById,
  getTaskDependencies,
  getTasks,
  removeTaskDependency,
  type TaskDependencyItem,
} from "@/lib/api/tasks";
import type {
  TaskStatus,
  User,
} from "@/types/api";

type Props = {
  taskId: string;
  user: User;
  projects: ProjectRecord[];
  onClose: () => void;
  onChanged: () => void | Promise<void>;
};

const STATUS_OPTIONS: Array<{
  status: TaskStatus;
  label: string;
}> = [
  {
    status: "TODO",
    label: "To Do",
  },
  {
    status: "IN_PROGRESS",
    label: "In Progress",
  },
  {
    status: "BLOCKED",
    label: "Blocked",
  },
  {
    status: "DONE",
    label: "Done",
  },
];

function formatDepartment(
  value?: string,
) {
  if (!value) return "—";

  if (value === "UI_UX") {
    return "UI / UX";
  }

  return value
    .toLowerCase()
    .replace(
      /\b\w/g,
      (letter) =>
        letter.toUpperCase(),
    );
}

function parseApiError(
  error: unknown,
) {
  if (
    axios.isAxiosError(error)
  ) {
    const message =
      typeof error.response?.data
        ?.message === "string"
        ? error.response.data
            .message
        : "Request failed.";

    return {
      message,
      conflict:
        error.response?.status ===
        409,
    };
  }

  return {
    message: "Request failed.",
    conflict: false,
  };
}

export function TaskDrawer({
  taskId,
  user,
  projects,
  onClose,
  onChanged,
}: Props) {
  const queryClient =
    useQueryClient();

  const [editOpen, setEditOpen] =
    useState(false);
  const [deleteOpen, setDeleteOpen] =
    useState(false);
  const [busy, setBusy] =
    useState(false);
  const [
    actionError,
    setActionError,
  ] = useState("");
  const [
    candidateId,
    setCandidateId,
  ] = useState("");

  const taskQuery = useQuery({
    queryKey: [
      "task-detail",
      taskId,
    ],
    queryFn: () =>
      getTaskById(taskId),
  });

  const dependencyQuery = useQuery({
    queryKey: [
      "task-dependencies",
      taskId,
    ],
    queryFn: () =>
      getTaskDependencies(
        taskId,
        {
          page: 1,
          rows: 100,
          orderKey:
            "createdAt",
          orderRule: "asc",
        },
      ),
  });

  const task =
    taskQuery.data ?? null;

  const dependencies =
    dependencyQuery.data?.data ??
    [];

  const projectId =
    task?.projectId ??
    task?.project?.id ??
    "";

  const candidateQuery = useQuery({
    queryKey: [
      "dependency-candidates",
      projectId,
    ],
    enabled:
      user.role === "PM" &&
      Boolean(projectId),
    queryFn: () =>
      getTasks({
        page: 1,
        rows: 100,
        filters: {
          projectId,
        },
        orderKey:
          "createdAt",
        orderRule: "asc",
      }),
  });

  const dependencyIds =
    useMemo(
      () =>
        new Set(
          dependencies.map(
            (dependency) =>
              dependency.id,
          ),
        ),
      [dependencies],
    );

  const candidates =
    candidateQuery.data?.data.filter(
      (candidate) =>
        candidate.id !==
          taskId &&
        !dependencyIds.has(
          candidate.id,
        ),
    ) ?? [];

  const unfinishedDependencies =
    dependencies.filter(
      (dependency) =>
        dependency.status !==
        "DONE",
    );

  const canChangeStatus =
    Boolean(task?.version) &&
    (user.role === "PM" ||
      (user.role ===
        "INTERNAL" &&
        task?.assigneeId ===
          user.id));

  async function refreshAll() {
    await Promise.all([
      queryClient.invalidateQueries({
        queryKey: ["tasks"],
      }),
      queryClient.invalidateQueries({
        queryKey: [
          "task-detail",
          taskId,
        ],
      }),
      queryClient.invalidateQueries({
        queryKey: [
          "task-dependencies",
          taskId,
        ],
      }),
      queryClient.invalidateQueries({
        queryKey: [
          "dependency-candidates",
        ],
      }),
    ]);

    await onChanged();
  }

  async function fail(
    error: unknown,
  ) {
    const parsed =
      parseApiError(error);

    setActionError(
      parsed.conflict
        ? `${parsed.message} Latest data has been reloaded.`
        : parsed.message,
    );

    if (parsed.conflict) {
      await refreshAll();
    }
  }

  function statusDisabled(
    target: TaskStatus,
  ) {
    if (
      busy ||
      !task ||
      !canChangeStatus ||
      task.status === target
    ) {
      return true;
    }

    if (
      user.role === "PM" &&
      target === "DONE"
    ) {
      return true;
    }

    if (
      unfinishedDependencies.length >
        0 &&
      target !== "BLOCKED"
    ) {
      return true;
    }

    return false;
  }

  async function moveStatus(
    status: TaskStatus,
  ) {
    if (
      !task?.version ||
      statusDisabled(status)
    ) {
      return;
    }

    setBusy(true);
    setActionError("");

    try {
      await changeTaskStatus(
        task.id,
        status,
        task.version,
      );

      await refreshAll();
    } catch (error) {
      await fail(error);
    } finally {
      setBusy(false);
    }
  }

  async function addDependency() {
    if (!candidateId) {
      return;
    }

    setBusy(true);
    setActionError("");

    try {
      await addTaskDependency(
        taskId,
        candidateId,
      );

      setCandidateId("");
      await refreshAll();
    } catch (error) {
      await fail(error);
    } finally {
      setBusy(false);
    }
  }

  async function removeDependency(
    dependency: TaskDependencyItem,
  ) {
    setBusy(true);
    setActionError("");

    try {
      await removeTaskDependency(
        taskId,
        dependency.id,
      );

      await refreshAll();
    } catch (error) {
      await fail(error);
    } finally {
      setBusy(false);
    }
  }

  async function confirmDelete() {
    if (!task?.version) {
      return;
    }

    setBusy(true);
    setActionError("");

    try {
      await deleteTask(
        task.id,
        task.version,
      );

      await onChanged();
      onClose();
    } catch (error) {
      await fail(error);
      setDeleteOpen(false);
      setBusy(false);
    }
  }

  return (
    <>
      <div className="fixed inset-0 z-[10010] flex justify-end bg-slate-950/30 backdrop-blur-[2px]">
        <button
          type="button"
          className="absolute inset-0"
          aria-label="Close task detail"
          onClick={onClose}
        />

        <aside className="relative z-10 h-full w-full max-w-xl overflow-y-auto border-l border-slate-200 bg-white shadow-[-20px_0_60px_rgba(15,23,42,0.14)]">
          <div className="sticky top-0 z-20 flex items-start justify-between border-b border-slate-100 bg-white/95 px-5 py-4 backdrop-blur">
            <div>
              <div className="text-[10px] font-extrabold tracking-[0.16em] text-cyan-600">
                TASK DETAIL
              </div>
              <div className="mt-1 text-xs text-slate-400">
                Workflow control
                and prerequisites
              </div>
            </div>

            <button
              type="button"
              onClick={onClose}
              className="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
              aria-label="Close"
            >
              <X className="size-4" />
            </button>
          </div>

          {taskQuery.isPending ? (
            <div className="p-8 text-center text-sm text-slate-500">
              Loading task...
            </div>
          ) : taskQuery.isError ||
            !task ? (
            <div className="m-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
              Task could not be
              loaded.
            </div>
          ) : (
            <div className="space-y-5 p-5">
              <section>
                <div className="flex flex-wrap items-center gap-2">
                  <span
                    className={`rounded-full px-2.5 py-1 text-[10px] font-bold ${
                      task.status ===
                      "DONE"
                        ? "bg-emerald-50 text-emerald-700"
                        : task.status ===
                            "BLOCKED"
                          ? "bg-amber-50 text-amber-700"
                          : task.status ===
                              "IN_PROGRESS"
                            ? "bg-blue-50 text-blue-700"
                            : "bg-slate-100 text-slate-600"
                    }`}
                  >
                    {task.status.replaceAll(
                      "_",
                      " ",
                    )}
                  </span>

                  {task.isClientVisible && (
                    <span className="flex items-center gap-1 rounded-full bg-cyan-50 px-2.5 py-1 text-[10px] font-bold text-cyan-700">
                      <Eye className="size-3" />
                      CLIENT VISIBLE
                    </span>
                  )}
                </div>

                <h2 className="mt-3 text-xl font-semibold tracking-[-0.03em] text-slate-950">
                  {task.title}
                </h2>

                <p className="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-500">
                  {task.description ||
                    "No task description provided."}
                </p>
              </section>

              {user.role !==
                "CLIENT" && (
                <section className="grid gap-3 sm:grid-cols-2">
                  <div className="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
                    <div className="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">
                      Department
                    </div>
                    <div className="mt-2 text-sm font-semibold text-slate-800">
                      {formatDepartment(
                        task.department,
                      )}
                    </div>
                  </div>

                  <div className="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
                    <div className="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">
                      <UserRound className="size-3.5" />
                      Assignee
                    </div>

                    <div className="mt-2 text-sm font-semibold text-slate-800">
                      {task.assignee
                        ?.name ??
                        "Unassigned"}
                    </div>

                    {task.assignee
                      ?.email && (
                      <div className="mt-1 text-[11px] text-slate-400">
                        {
                          task
                            .assignee
                            .email
                        }
                      </div>
                    )}
                  </div>
                </section>
              )}

              {user.role !==
                "CLIENT" && (
                <section className="rounded-2xl border border-slate-200 p-4">
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <div className="text-[10px] font-extrabold tracking-[0.14em] text-cyan-600">
                        STATUS CONTROL
                      </div>
                      <h3 className="mt-1 text-sm font-semibold text-slate-900">
                        Workflow state
                      </h3>
                    </div>

                    {!canChangeStatus && (
                      <span className="flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-semibold text-slate-500">
                        <LockKeyhole className="size-3" />
                        READ ONLY
                      </span>
                    )}
                  </div>

                  {unfinishedDependencies.length >
                    0 && (
                    <div className="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5 text-xs leading-5 text-amber-800">
                      Unfinished
                      prerequisites keep
                      this task blocked.
                      Other states are
                      disabled until every
                      prerequisite is Done.
                    </div>
                  )}

                  {user.role ===
                    "PM" && (
                    <div className="mt-3 rounded-xl border border-blue-100 bg-blue-50 px-3 py-2.5 text-[11px] leading-5 text-blue-700">
                      PM may control
                      workflow states but
                      cannot complete a
                      task as Done.
                    </div>
                  )}

                  {user.role ===
                    "INTERNAL" &&
                    task.assigneeId !==
                      user.id && (
                      <div className="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-[11px] leading-5 text-slate-500">
                        Only the assigned
                        executor may change
                        this task status.
                      </div>
                    )}

                  <div className="mt-4 grid grid-cols-2 gap-2">
                    {STATUS_OPTIONS.map(
                      (option) => (
                        <Button
                          key={
                            option.status
                          }
                          type="button"
                          variant={
                            task.status ===
                            option.status
                              ? "default"
                              : "outline"
                          }
                          disabled={statusDisabled(
                            option.status,
                          )}
                          onClick={() =>
                            void moveStatus(
                              option.status,
                            )
                          }
                          className="justify-start"
                        >
                          {option.status ===
                          "DONE" ? (
                            <CheckCircle2 className="size-4" />
                          ) : option.status ===
                            "BLOCKED" ? (
                            <TriangleAlert className="size-4" />
                          ) : (
                            <CircleDashed className="size-4" />
                          )}

                          {option.label}
                        </Button>
                      ),
                    )}
                  </div>
                </section>
              )}

              <section className="rounded-2xl border border-slate-200 p-4">
                <div className="flex items-center gap-2">
                  <GitBranch className="size-4 text-cyan-600" />
                  <div>
                    <div className="text-[10px] font-extrabold tracking-[0.14em] text-cyan-600">
                      DEPENDENCIES
                    </div>
                    <h3 className="mt-1 text-sm font-semibold text-slate-900">
                      Prerequisites
                    </h3>
                  </div>
                </div>

                {dependencyQuery.isPending ? (
                  <div className="mt-4 text-xs text-slate-400">
                    Loading
                    dependencies...
                  </div>
                ) : dependencies.length ===
                  0 ? (
                  <div className="mt-4 rounded-xl border border-dashed border-slate-200 bg-slate-50 px-3 py-5 text-center text-xs text-slate-400">
                    No prerequisites
                    configured.
                  </div>
                ) : (
                  <div className="mt-4 space-y-2">
                    {dependencies.map(
                      (
                        dependency,
                      ) => (
                        <div
                          key={
                            dependency.id
                          }
                          className="flex items-center justify-between gap-3 rounded-xl border border-slate-200 px-3 py-2.5"
                        >
                          <div className="min-w-0">
                            <div className="truncate text-xs font-semibold text-slate-700">
                              {
                                dependency.title
                              }
                            </div>

                            <div className="mt-1 text-[10px] text-slate-400">
                              {dependency.status.replaceAll(
                                "_",
                                " ",
                              )}

                              {dependency.department
                                ? ` · ${formatDepartment(
                                    dependency.department,
                                  )}`
                                : ""}
                            </div>
                          </div>

                          {user.role ===
                            "PM" && (
                            <button
                              type="button"
                              disabled={busy}
                              onClick={() =>
                                void removeDependency(
                                  dependency,
                                )
                              }
                              className="shrink-0 rounded-lg p-1.5 text-slate-400 transition hover:bg-red-50 hover:text-red-600 disabled:opacity-40"
                              aria-label="Remove dependency"
                            >
                              <X className="size-3.5" />
                            </button>
                          )}
                        </div>
                      ),
                    )}
                  </div>
                )}

                {user.role ===
                  "PM" && (
                  <div className="mt-4 flex gap-2">
                    <select
                      value={
                        candidateId
                      }
                      onChange={(
                        event,
                      ) =>
                        setCandidateId(
                          event
                            .target
                            .value,
                        )
                      }
                      className="h-9 min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-3 text-xs text-slate-700 outline-none focus:border-cyan-400 focus:ring-4 focus:ring-cyan-500/10"
                    >
                      <option value="">
                        Add
                        prerequisite...
                      </option>

                      {candidates.map(
                        (
                          candidate,
                        ) => (
                          <option
                            key={
                              candidate.id
                            }
                            value={
                              candidate.id
                            }
                          >
                            {
                              candidate.title
                            }{" "}
                            ·{" "}
                            {candidate.status.replaceAll(
                              "_",
                              " ",
                            )}
                          </option>
                        ),
                      )}
                    </select>

                    <Button
                      type="button"
                      size="sm"
                      variant="outline"
                      disabled={
                        !candidateId ||
                        busy
                      }
                      onClick={() =>
                        void addDependency()
                      }
                    >
                      Add
                    </Button>
                  </div>
                )}
              </section>

              {actionError && (
                <div className="rounded-xl border border-red-200 bg-red-50 px-3 py-2.5 text-xs leading-5 text-red-700">
                  {actionError}
                </div>
              )}

              {user.role ===
                "PM" && (
                <section className="flex flex-wrap gap-2 border-t border-slate-100 pt-5">
                  <Button
                    type="button"
                    variant="outline"
                    onClick={() =>
                      setEditOpen(
                        true,
                      )
                    }
                  >
                    <Pencil className="size-4" />
                    Edit task
                  </Button>

                  <Button
                    type="button"
                    variant="outline"
                    className="border-red-200 text-red-600 hover:bg-red-50 hover:text-red-700"
                    onClick={() =>
                      setDeleteOpen(
                        true,
                      )
                    }
                  >
                    <Trash2 className="size-4" />
                    Delete task
                  </Button>
                </section>
              )}
            </div>
          )}
        </aside>
      </div>

      {editOpen &&
        task &&
        user.role === "PM" && (
          <TaskFormModal
            mode="edit"
            task={task}
            projects={projects}
            onClose={() =>
              setEditOpen(false)
            }
            onSaved={refreshAll}
          />
        )}

      {deleteOpen &&
        task &&
        user.role === "PM" && (
          <div className="fixed inset-0 z-[10040] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-sm">
            <button
              type="button"
              className="absolute inset-0"
              aria-label="Close delete confirmation"
              onClick={() =>
                setDeleteOpen(false)
              }
            />

            <div className="relative z-10 w-full max-w-md rounded-[22px] border border-slate-200 bg-white shadow-2xl">
              <div className="border-b border-slate-100 p-5">
                <h3 className="text-base font-semibold text-slate-900">
                  Delete task?
                </h3>
                <p className="mt-1 text-xs leading-5 text-slate-500">
                  The backend
                  performs a soft
                  delete and keeps
                  the task audit
                  history.
                </p>
              </div>

              <div className="p-5">
                <div className="rounded-xl border border-red-100 bg-red-50 px-3 py-3 text-sm font-semibold text-red-700">
                  {task.title}
                </div>

                <div className="mt-5 flex justify-end gap-2">
                  <Button
                    variant="outline"
                    disabled={busy}
                    onClick={() =>
                      setDeleteOpen(
                        false,
                      )
                    }
                  >
                    Cancel
                  </Button>

                  <Button
                    disabled={busy}
                    className="bg-red-600 text-white hover:bg-red-700"
                    onClick={() =>
                      void confirmDelete()
                    }
                  >
                    <Trash2 className="size-4" />
                    {busy
                      ? "Deleting..."
                      : "Delete task"}
                  </Button>
                </div>
              </div>
            </div>
          </div>
        )}
    </>
  );
}


