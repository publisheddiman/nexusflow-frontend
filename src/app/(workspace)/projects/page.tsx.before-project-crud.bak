"use client";

import { useQuery } from "@tanstack/react-query";
import {
  ArrowUpRight,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  CircleDashed,
  FolderKanban,
  Search,
  TriangleAlert,
  X,
} from "lucide-react";
import Link from "next/link";
import { useState, type FormEvent } from "react";
import { Button } from "@/components/ui/button";
import { getProjects } from "@/lib/api/projects";
import { getTasks } from "@/lib/api/tasks";
import { useAuthStore } from "@/stores/auth-store";

const PAGE_SIZE = 6;

function formatDate(value: string) {
  return new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
  }).format(new Date(value));
}

export default function ProjectsPage() {
  const user = useAuthStore((state) => state.user);

  const [page, setPage] = useState(1);
  const [searchInput, setSearchInput] = useState("");
  const [searchTerm, setSearchTerm] = useState("");

  const projectsQuery = useQuery({
    queryKey: ["projects", "list", page, searchTerm],
    queryFn: () =>
      getProjects({
        page,
        rows: PAGE_SIZE,
        orderKey: "createdAt",
        orderRule: "desc",
        ...(searchTerm
          ? {
              searchFilters: {
                name: searchTerm,
                description: searchTerm,
              },
            }
          : {}),
      }),
  });

  const tasksQuery = useQuery({
    queryKey: ["tasks", "projects-summary"],
    queryFn: () =>
      getTasks({
        page: 1,
        rows: 100,
        orderKey: "updatedAt",
        orderRule: "desc",
      }),
  });

  if (!user) return null;

  const projects = projectsQuery.data?.data ?? [];
  const pagination = projectsQuery.data?.pagination;
  const tasks = tasksQuery.data?.data ?? [];

  const totalProjects = pagination?.totalData ?? projects.length;
  const totalPages = Math.max(pagination?.totalPage ?? 1, 1);
  const loading = projectsQuery.isPending;

  function handleSearch(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setPage(1);
    setSearchTerm(searchInput.trim());
  }

  function clearSearch() {
    setSearchInput("");
    setSearchTerm("");
    setPage(1);
  }

  return (
    <div className="px-5 py-7 sm:px-7 lg:px-9 lg:py-8">
      <div className="mx-auto max-w-[1500px]">
        <section className="mb-6">
          <div className="text-[11px] font-extrabold tracking-[0.18em] text-cyan-600">
            PROJECT MANAGEMENT
          </div>

          <div className="mt-2 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <h1 className="text-3xl font-semibold tracking-[-0.04em] text-slate-950 sm:text-[34px]">
                Projects
              </h1>
              <p className="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
                Browse engineering projects, review delivery progress, and open
                the project workspace.
              </p>
            </div>

            <div className="flex items-center gap-2">
              <div className="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 shadow-sm">
                {projectsQuery.isPending ? "Loading..." : `${totalProjects} projects`}
              </div>

              {user.role === "PM" && (
                <div
                  className="rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1.5 text-xs font-semibold text-cyan-700"
                  title="Project creation will be connected in the next step."
                >
                  PM Workspace
                </div>
              )}
            </div>
          </div>
        </section>

        <section className="mb-5 rounded-[20px] border border-slate-200/80 bg-white p-3 shadow-sm sm:p-4">
          <form
            onSubmit={handleSearch}
            className="flex flex-col gap-2 sm:flex-row sm:items-center"
          >
            <div className="relative min-w-0 flex-1">
              <Search className="absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-slate-400" />
              <input
                type="search"
                value={searchInput}
                onChange={(event) => setSearchInput(event.target.value)}
                placeholder="Search project name or description..."
                className="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-10 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-cyan-400 focus:bg-white focus:ring-4 focus:ring-cyan-500/10"
              />

              {searchInput && (
                <button
                  type="button"
                  onClick={clearSearch}
                  aria-label="Clear search"
                  className="absolute right-3 top-1/2 -translate-y-1/2 rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                >
                  <X className="size-4" />
                </button>
              )}
            </div>

            <Button type="submit" className="h-11 px-5">
              <Search className="size-4" />
              Search
            </Button>

            {searchTerm && (
              <Button
                type="button"
                variant="outline"
                className="h-11"
                onClick={clearSearch}
              >
                Clear
              </Button>
            )}
          </form>
        </section>

        {projectsQuery.isError && (
          <section className="mb-5 rounded-[18px] border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <div className="font-semibold">Unable to load projects</div>
            <div className="mt-1 text-xs text-red-600">
              Check the backend connection and try again.
            </div>
          </section>
        )}

        {loading ? (
          <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {[1, 2, 3, 4, 5, 6].map((item) => (
              <div
                key={item}
                className="h-[260px] animate-pulse rounded-[22px] border border-slate-200 bg-white p-5 shadow-sm"
              >
                <div className="size-11 rounded-xl bg-slate-100" />
                <div className="mt-5 h-3 w-20 rounded bg-slate-100" />
                <div className="mt-3 h-5 w-2/3 rounded bg-slate-100" />
                <div className="mt-4 h-3 w-full rounded bg-slate-100" />
                <div className="mt-2 h-3 w-4/5 rounded bg-slate-100" />
              </div>
            ))}
          </section>
        ) : projects.length === 0 ? (
          <section className="rounded-[22px] border border-dashed border-slate-300 bg-white px-6 py-16 text-center shadow-sm">
            <div className="mx-auto flex size-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
              <FolderKanban className="size-5" />
            </div>
            <h2 className="mt-4 text-base font-semibold text-slate-900">
              No projects found
            </h2>
            <p className="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
              {searchTerm
                ? "No projects match your current search. Try another keyword."
                : "There are no projects available in your workspace yet."}
            </p>
            {searchTerm && (
              <Button variant="outline" className="mt-4" onClick={clearSearch}>
                Clear search
              </Button>
            )}
          </section>
        ) : (
          <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {projects.map((project) => {
              const scopedTasks = tasks.filter(
                (task) => task.projectId === project.id,
              );
              const completed = scopedTasks.filter(
                (task) => task.status === "DONE",
              ).length;
              const blocked = scopedTasks.filter(
                (task) => task.status === "BLOCKED",
              ).length;
              const inProgress = scopedTasks.filter(
                (task) => task.status === "IN_PROGRESS",
              ).length;
              const progress =
                scopedTasks.length === 0
                  ? 0
                  : Math.round((completed / scopedTasks.length) * 100);

              return (
                <article
                  key={project.id}
                  className="group flex min-h-[275px] flex-col rounded-[22px] border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-[0_16px_40px_rgba(15,23,42,0.08)]"
                >
                  <div className="flex items-start justify-between gap-4">
                    <div className="flex size-11 items-center justify-center rounded-xl bg-cyan-50 text-cyan-600 ring-1 ring-inset ring-cyan-100">
                      <FolderKanban className="size-5" />
                    </div>

                    <div className="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[10px] font-bold tracking-[0.12em] text-slate-500">
                      PROJECT
                    </div>
                  </div>

                  <div className="mt-5 min-w-0">
                    <h2 className="truncate text-[17px] font-semibold tracking-[-0.02em] text-slate-900">
                      {project.name}
                    </h2>
                    <p className="mt-2 line-clamp-2 min-h-10 text-sm leading-5 text-slate-500">
                      {project.description || "No project description provided."}
                    </p>
                  </div>

                  <div className="mt-5">
                    <div className="mb-2 flex items-center justify-between text-[11px]">
                      <span className="font-medium text-slate-500">
                        Delivery progress
                      </span>
                      <span className="font-semibold text-slate-700">
                        {tasksQuery.isPending ? "â€”" : `${progress}%`}
                      </span>
                    </div>

                    <div className="h-1.5 overflow-hidden rounded-full bg-slate-100">
                      <div
                        className="h-full rounded-full bg-gradient-to-r from-cyan-500 to-blue-600 transition-all"
                        style={{ width: `${progress}%` }}
                      />
                    </div>
                  </div>

                  <div className="mt-4 grid grid-cols-3 gap-2">
                    <div className="rounded-xl bg-slate-50 px-2.5 py-2">
                      <div className="flex items-center gap-1 text-[10px] text-slate-400">
                        <CircleDashed className="size-3" />
                        Tasks
                      </div>
                      <div className="mt-1 text-sm font-semibold text-slate-700">
                        {tasksQuery.isPending ? "â€”" : scopedTasks.length}
                      </div>
                    </div>

                    <div className="rounded-xl bg-emerald-50/70 px-2.5 py-2">
                      <div className="flex items-center gap-1 text-[10px] text-emerald-600">
                        <CheckCircle2 className="size-3" />
                        Done
                      </div>
                      <div className="mt-1 text-sm font-semibold text-emerald-700">
                        {tasksQuery.isPending ? "â€”" : completed}
                      </div>
                    </div>

                    <div className="rounded-xl bg-amber-50/70 px-2.5 py-2">
                      <div className="flex items-center gap-1 text-[10px] text-amber-600">
                        <TriangleAlert className="size-3" />
                        Blocked
                      </div>
                      <div className="mt-1 text-sm font-semibold text-amber-700">
                        {tasksQuery.isPending ? "â€”" : blocked}
                      </div>
                    </div>
                  </div>

                  <div className="mt-auto flex items-center justify-between gap-3 border-t border-slate-100 pt-4">
                    <div>
                      <div className="text-[10px] uppercase tracking-wide text-slate-400">
                        Created
                      </div>
                      <div className="mt-1 text-xs font-medium text-slate-600">
                        {formatDate(project.createdAt)}
                      </div>
                    </div>

                    <Button asChild variant="outline" size="sm">
                      <Link href={`/projects/${project.id}`}>
                        Open project
                        <ArrowUpRight className="size-3.5" />
                      </Link>
                    </Button>
                  </div>

                  {inProgress > 0 && (
                    <div className="mt-3 text-[10px] text-blue-600">
                      {inProgress} task{inProgress === 1 ? "" : "s"} currently in
                      progress
                    </div>
                  )}
                </article>
              );
            })}
          </section>
        )}

        {!loading && !projectsQuery.isError && totalProjects > 0 && (
          <footer className="mt-5 flex flex-col gap-3 rounded-[18px] border border-slate-200 bg-white px-4 py-3 shadow-sm sm:flex-row sm:items-center sm:justify-between">
            <div className="text-xs text-slate-500">
              Page{" "}
              <span className="font-semibold text-slate-700">
                {pagination?.page ?? page}
              </span>{" "}
              of{" "}
              <span className="font-semibold text-slate-700">{totalPages}</span>
              <span className="ml-2 text-slate-400">
                {totalProjects} projects
              </span>
            </div>

            <div className="flex items-center gap-2">
              <Button
                variant="outline"
                size="sm"
                disabled={page <= 1}
                onClick={() => setPage((current) => Math.max(1, current - 1))}
              >
                <ChevronLeft className="size-4" />
                Previous
              </Button>

              <Button
                variant="outline"
                size="sm"
                disabled={page >= totalPages}
                onClick={() => setPage((current) => current + 1)}
              >
                Next
                <ChevronRight className="size-4" />
              </Button>
            </div>
          </footer>
        )}
      </div>
    </div>
  );
}

